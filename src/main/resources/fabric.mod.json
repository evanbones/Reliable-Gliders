{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "noelledotjpg"
  ],
  "contact": {
    "homepage": "https://github.com/evanbones/Reliable-Gliders",
    "sources": "https://github.com/evanbones/Reliable-Gliders",
    "issues": "https://github.com/evanbones/Reliable-Gliders/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.evandev.reliable_gliders.fabric.ReliableGlidersFabric"
    ],
    "client": [
      "com.evandev.reliable_gliders.fabric.ReliableGlidersFabricClient"
    ],
    "modmenu": [
      "com.evandev.reliable_gliders.fabric.compat.ModMenuIntegration"
    ],
    "emi": [
      "com.evandev.reliable_gliders.compat.emi.ReliableGlidersEmiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "yet_another_config_lib_v3": ">=${yacl_version}",
    "modmenu": "*"
  }
}
